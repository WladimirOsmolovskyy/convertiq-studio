# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.

# ── Supabase (required) ──────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service-role key — server-only, used by admin client for cross-RLS reads
# (e.g. /api/ai-score resolving questionnaire owner). Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── OpenAI (legacy / dev fallback) ───────────────────────────────
# Production reads OpenAI keys per-user from `user_api_keys` (Settings UI).
# This var is no longer required at runtime but useful for local development.
OPENAI_API_KEY=sk-your-openai-key

# ── GoHighLevel OAuth (required if using GHL integration) ────────
GHL_CLIENT_ID=your-ghl-client-id
GHL_CLIENT_SECRET=your-ghl-client-secret

# ── Photoroom (required for /dashboard/tools/background-remover) ──
# Server-side API key for background removal. Never exposed to the browser.
PHOTOROOM_API_KEY=your-photoroom-key

# ── Vercel (optional — for custom domain provisioning) ───────────
# When unset, src/lib/vercel.ts runs in MOCK mode (local dev works fine).
# Set these in Vercel env vars for staging/prod, not in local .env.local.
# VERCEL_TOKEN=
# VERCEL_PROJECT_ID=
# VERCEL_TEAM_ID=

# ── Worktree-local (don't commit, varies per worktree) ───────────
# Set PORT here in each worker worktree to avoid dev-server port collisions:
#   PORT=3001   (agent-1)
#   PORT=3002   (agent-2)
#   PORT=3003   (agent-3)
